# Copy to .env next to compose.yml. Every setting is optional.

# Host port, published on all host interfaces by default.
# Set a different port here if 8080 is already in use.
#TEADECK_PUBLISH=8080

# Image tag. Use latest or an existing sha-<12-character-commit> tag.
#TEADECK_TAG=latest

# Built-in logo: flat, glass, ceramic or mastodon. Unset means no logo.
# The teacups follow the selected theme's colours.
#TEADECK_LOGO=glass

# Custom SVG in ./logo. Use only the filename; this overrides TEADECK_LOGO.
# A regular SVG is shown as an image. For theme colours, add data-teadeck-logo
# to its root <svg> and use var(--teadeck-logo-...) colour roles.
# Example: integration/logos/teacup-flat.svg
#TEADECK_LOGO_FILE=my-logo.svg

# Default theme for people who have not made their own choice:
#   assam     Assam (dark) / Silver Needle (light), the default
#   sencha    Sencha (dark) / Jasmine (light)
#   hibiscus  Hibiscus (dark) / Rooibos (light), square and in capitals
#   mastodon  Mastodon's appearance
#TEADECK_THEME=assam

# Colour scheme: auto follows the operating system; light or dark fixes it.
# A user's own theme and colour-scheme choices take precedence.
#TEADECK_COLOR_SCHEME=auto
