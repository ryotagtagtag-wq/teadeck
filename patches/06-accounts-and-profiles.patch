+// Servers without /api/v1/profile edit it through update_credentials; see api_compat.ts.
+const profileFromCredentials = async () => {
+  setSupport('profile.featuredTags', 'unsupported');
+  setSupport('profile.tabSettings', 'unsupported');
+  return profileFromCredentialAccount(
+    await apiRequestGet<ApiAccountJSON>('v1/accounts/verify_credentials'),
+  ) as ApiProfileJSON;
+};
+
+const noteProfileParts = (profile: ApiProfileJSON) => {
+  setSupport('profile.featuredTags', Array.isArray(profile.featured_tags) ? 'supported' : 'unsupported');
+  setSupport('profile.tabSettings', typeof profile.show_media === 'boolean' ? 'supported' : 'unsupported');
+  return profile;
+};
+
+export const apiGetProfile = () =>
+  withCapability<ApiProfileJSON>(
+    'profile.read',
+    async () => noteProfileParts(await apiRequestGet<ApiProfileJSON>('v1/profile')),
+    profileFromCredentials,
+  );
+
+const patchCredentials = async (params: ApiProfileUpdateParams | FormData) => {
+  const body =
+    params instanceof FormData
+      ? params
+      : credentialsUpdateFromProfileParams(params);
+  if (!body) return profileFromCredentials();
+  return profileFromCredentialAccount(
+    await apiRequestPatch<ApiAccountJSON>('v1/accounts/update_credentials', body),
+  ) as ApiProfileJSON;
+};
 
 export const apiPatchProfile = (params: ApiProfileUpdateParams | FormData) =>
-  apiRequestPatch<ApiProfileJSON>('v1/profile', params);
+  withCapability<ApiProfileJSON>(
+    'profile.write',
+    async () => noteProfileParts(await apiRequestPatch<ApiProfileJSON>('v1/profile', params)),
+    () => patchCredentials(params),
+  );
 
 export const apiDeleteProfileAvatar = () =>
   apiRequestDelete('v1/profile/avatar');
