-export const apiGetSearch = (
+// A search for "#tag" returns only hashtags on GoToSocial (and on Mastodon
+// without full-text search). If the first page of such a search has no posts,
+// all post pages of that search come from the hashtag's timeline, paged by
+// max_id; a search that returned posts itself never switches source.
+const hashtagSearches = createHashtagSearchPages();
+
+const tagTimeline = (
+  tag: string,
+  params: { limit: number; max_id?: string },
+  options: { signal?: AbortSignal },
+) =>
+  apiRequestGet<ApiStatusJSON[]>(
+    `v1/timelines/tag/${encodeURIComponent(tag)}`,
+    params,
+    options,
+  );
+
+export const apiGetSearch = async (
   params: {
     q: string;
     resolve?: boolean;
@@ -15,11 +38,49 @@ export const apiGetSearch = (
   options: {
     signal?: AbortSignal;
   } = {},
-) =>
-  apiRequestGet<ApiSearchResultsJSON>(
-    'v2/search',
-    {
-      ...params,
-    },
-    options,
+) => {
+  const limit = params.limit ?? 20;
+  const isFirstPage = !params.offset;
+  const wantsStatuses = !params.type || params.type === 'statuses';
+
+  // Further post pages of a search answered from the hashtag timeline.
+  const timelineSearch = hashtagSearches.next(params.q);
+  if (!isFirstPage && params.type === 'statuses' && timelineSearch) {
+    const statuses = timelineSearch.done
+      ? []
+      : await tagTimeline(
+          timelineSearch.tag,
+          { limit, max_id: timelineSearch.maxId },
+          options,
+        );
+    hashtagSearches.continue(params.q, statuses, limit);
+    return applySearchDefaults({ statuses } as Partial<ApiSearchResultsJSON>) as ApiSearchResultsJSON;
+  }
+
+  const results = applySearchDefaults(
+    await apiRequestGet<ApiSearchResultsJSON>(
+      'v2/search',
+      {
+        ...params,
+      },
+      options,
+    ),
   );
+
+  if (isFirstPage) {
+    hashtagSearches.reset(params.q);
+    const tag = hashtagFromQuery(params.q);
+    if (tag && wantsStatuses && results.statuses.length === 0) {
+      // If the timeline fails, keep the accounts and hashtags the search found.
+      const statuses = await tagTimeline(tag, { limit }, options).catch(
+        () => undefined,
+      );
+      if (statuses) {
+        results.statuses = statuses;
+        hashtagSearches.start(params.q, tag, statuses, limit);
+      }
+    }
+  }
+
+  return results;
+};
