diff --git a/app/javascript/mastodon/features/emoji/origin.ts b/app/javascript/mastodon/features/emoji/origin.ts
new file mode 100644
--- /dev/null
+++ b/app/javascript/mastodon/features/emoji/origin.ts
@@ -0,0 +1,22 @@
+let emojiOrigin: string | undefined;
+let emojiAccessToken: string | undefined;
+
+export function setEmojiOrigin(origin: string, accessToken?: string) {
+  emojiOrigin = new URL(origin).origin;
+  emojiAccessToken = accessToken;
+}
+
+// Some servers (e.g. GoToSocial) only list custom emojis to authenticated clients.
+export function getEmojiAuthorization() {
+  return emojiAccessToken ? `Bearer ${emojiAccessToken}` : undefined;
+}
+
+export function getEmojiOrigin() {
+  return emojiOrigin ?? location.origin;
+}
+
+export function getEmojiDatabaseName() {
+  return emojiOrigin
+    ? `mastodon-emoji-${encodeURIComponent(emojiOrigin)}`
+    : 'mastodon-emoji';
+}
